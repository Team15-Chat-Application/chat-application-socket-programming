# Development servers bind to loopback by default.
NODE_HOST=127.0.0.1
NODE_PORT=3000
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Run npm run setup to generate a private signing key in ignored .env.
# Production also requires NODE_ENV=production, TLS_CERT_PATH and TLS_KEY_PATH.
# Flask additionally honors FLASK_ENV=production; either production flag enforces TLS/key requirements.
# Optional: NODE_DB_PATH=data/chat.sqlite and FLASK_DB_PATH=data/flask.sqlite.
